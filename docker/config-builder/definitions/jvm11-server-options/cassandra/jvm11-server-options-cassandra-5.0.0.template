# This file is managed by CassKop through cass-config-builder.
# Manual edits will be overwritten the next time the pod is bootstrapped.

###########################################################################
#                         jvm11-server.options                            #
#                                                                         #
# See jvm-server.options. This file is specific for Java 11 and newer.    #
###########################################################################

#################
#  GC SETTINGS  #
#################

{% ifequal garbage_collector "G1GC" %}
-XX:+UseG1GC
-XX:+ParallelRefProcEnabled
-XX:+UnlockExperimentalVMOptions
{% endifequal %}

{% ifequal garbage_collector "ZGC" %}
-XX:+UnlockExperimentalVMOptions
-XX:+UseZGC
{% endifequal %}

{% ifequal garbage_collector "Shenandoah" %}
-XX:+UnlockExperimentalVMOptions
-XX:+UseShenandoahGC
{% endifequal %}

{% ifequal garbage_collector "Graal" %}
-XX:+UnlockExperimentalVMOptions
-XX:+UseJVMCICompiler
{% endifequal %}

{% comment %} Rendered after the GC block: experimental G1 options need UnlockExperimentalVMOptions first {% endcomment %}
{% for template_iterable in template_iterables %}{% if template_iterable %}{{template_iterable}}
{% endif %}{% endfor %}

###################
#  JPMS SETTINGS  #
###################

{{jdk_attach_allow_attach_self}}
--add-exports java.base/jdk.internal.misc=ALL-UNNAMED
--add-exports java.base/jdk.internal.ref=ALL-UNNAMED
--add-exports java.base/jdk.internal.util=ALL-UNNAMED
--add-exports java.base/sun.nio.ch=ALL-UNNAMED
--add-exports java.management.rmi/com.sun.jmx.remote.internal.rmi=ALL-UNNAMED
--add-exports java.rmi/sun.rmi.registry=ALL-UNNAMED
--add-exports java.rmi/sun.rmi.server=ALL-UNNAMED
--add-exports java.sql/java.sql=ALL-UNNAMED
--add-opens java.base/java.lang.module=ALL-UNNAMED
--add-opens java.base/jdk.internal.loader=ALL-UNNAMED
--add-opens java.base/jdk.internal.ref=ALL-UNNAMED
--add-opens java.base/jdk.internal.reflect=ALL-UNNAMED
--add-opens java.base/jdk.internal.math=ALL-UNNAMED
--add-opens java.base/jdk.internal.module=ALL-UNNAMED
--add-opens java.base/jdk.internal.util.jar=ALL-UNNAMED
--add-opens jdk.management/com.sun.management.internal=ALL-UNNAMED

{{io_netty_try_reflection_set_accessible}}

{% comment %} Additional options {% endcomment %}
{% for jvm-opt in additional-jvm-opts %}{{jvm-opt}}
{% endfor %}

# The newline in the end of file is intentional
