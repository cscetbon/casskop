(
  ;; Begin Cassandra 4.x transforms.
  "4.0.0" "jvm11-server-options-cassandra-4.0.0.edn"
  ;; End Cassandra 4.x transforms.

  ;; Begin Cassandra 5.x transforms: G1 tuning and JPMS exports shipped with 5.0's jvm11-server.options
  "5.0.0" (transforms
           (update-template "jvm11-server-options-cassandra-5.0.0.template")
           (update-field :max_gc_pause_millis {:default_value "300"})
           (update-field :initiating_heap_occupancy_percent {:default_value "70"})
           (add-field :max_tenuring_threshold
                      {:type "int",
                       :label "Max Tenuring Threshold",
                       :default_value "2",
                       :depends :garbage_collector,
                       :conditional [{:eq "G1GC"}],
                       :constant "-XX:MaxTenuringThreshold"}
                      :group "Garbage Collector Settings")
           (add-field :g1_heap_region_size
                      {:type "string",
                       :label "G1GC Heap Region Size",
                       :default_value "16m",
                       :render-without-quotes true,
                       :depends :garbage_collector,
                       :conditional [{:eq "G1GC"}],
                       :constant "-XX:G1HeapRegionSize"}
                      :group "Garbage Collector Settings")
           (add-field :g1_new_size_percent
                      {:type "int",
                       :label "G1GC New Size Percentage",
                       :default_value "50",
                       :depends :garbage_collector,
                       :conditional [{:eq "G1GC"}],
                       :constant "-XX:G1NewSizePercent"}
                      :group "Garbage Collector Settings")
           (add-field :use_biased_locking
                      {:type "boolean",
                       :label "Disable biased locking as it does not benefit Cassandra (Java 11 only)",
                       :static_constant "-XX:-UseBiasedLocking",
                       :default_value true}
                      :group "JPMS Settings")
           (add-field :io_netty_allocator_use_cache_for_all_threads
                      {:type "boolean",
                       :label "io.netty.allocator.useCacheForAllThreads",
                       :static_constant "-Dio.netty.allocator.useCacheForAllThreads=true",
                       :default_value true}
                      :group "JPMS Settings")
           (add-field :io_netty_allocator_max_order
                      {:type "boolean",
                       :label "io.netty.allocator.maxOrder",
                       :static_constant "-Dio.netty.allocator.maxOrder=11",
                       :default_value true}
                      :group "JPMS Settings"))
  ;; End Cassandra 5.x transforms.
)
